# ---------------------------------------------------------------------------
# auth-service
#
# This file holds the two most sensitive values in the system. Neither service
# A nor service B should ever be able to read them.
# ---------------------------------------------------------------------------
AUTH_PORT=3000
HOST=0.0.0.0

# HMAC key protecting access tokens at rest. 32+ bytes.
# Rotating this invalidates every token in the fleet — which is the intended
# fleet-wide reset. Generate with: openssl rand -base64 48
TOKEN_PEPPER=change-me-openssl-rand-base64-48

# Management API key for the /admin endpoints. Whoever holds this can issue
# credentials for any application.
# Generate with: openssl rand -hex 32
ADMIN_API_KEY=change-me-openssl-rand-hex-32

# Access token lifetime in seconds. Refused above 3600.
ACCESS_TOKEN_TTL_SECONDS=600

# Default lifetime for a newly issued application secret. 0 means no expiry
# and is discouraged.
SECRET_DEFAULT_TTL_DAYS=180

# How long the previous secret keeps working after a rotation.
ROTATION_GRACE_MINUTES=60

# Token endpoint throttling: failures per client_id+IP in a 15 minute window,
# and how long the resulting lockout lasts.
MAX_FAILED_ATTEMPTS=10
LOCKOUT_SECONDS=300

# Express `trust proxy` setting. Must match your load balancer for client IPs
# in the audit trail and the rate limiter to be real.
TRUST_PROXY=loopback

# `memory` writes a JSON file under ./data and is for local work only.
DB_CONNECTOR=memory
# DB_CONNECTOR=postgresql
# DB_URL=postgres://user:pass@localhost:5432/tra_auth
# DB_SSL=true
