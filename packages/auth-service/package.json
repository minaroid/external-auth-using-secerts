{
  "name": "@tra/auth-service",
  "version": "1.0.0",
  "description": "Central authentication service: application registry, secret lifecycle, token issuance and introspection. Also ships the client SDK other services use, under the ./client subpath.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "start": "node -r dotenv/config dist/index.js",
    "dev": "npm run build && npm start"
  },
  "dependencies": {
    "@loopback/authentication": "^12.0.17",
    "@loopback/boot": "^8.0.16",
    "@loopback/core": "^7.0.15",
    "@loopback/repository": "^8.0.15",
    "@loopback/rest": "^15.0.16",
    "@loopback/rest-explorer": "^8.0.16",
    "@loopback/security": "^0.12.15",
    "dotenv": "^16.4.5",
    "loopback-connector-postgresql": "^7.1.6",
    "tslib": "^2.6.3"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "typescript": "~5.6.3"
  },
  "files": [
    "dist",
    "src"
  ],
  "typesVersions": {
    "*": {
      "client": [
        "dist/client/index.d.ts"
      ],
      "*": [
        "dist/index.d.ts"
      ]
    }
  }
}
