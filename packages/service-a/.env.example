# ---------------------------------------------------------------------------
# service-a — the caller
#
# The only credential here is service A's own. It cannot read service B's
# secret, the token pepper or the admin key.
# ---------------------------------------------------------------------------
A_PORT=3001
HOST=0.0.0.0

AUTH_BASE_URL=http://localhost:3000
SERVICE_B_BASE_URL=http://localhost:3002

# This service's own identity at the auth service.
# CLIENT_SECRET is written by `npm run seed`; in production it comes from your
# secret store, not from a file.
CLIENT_ID=service-a
CLIENT_SECRET=

# The audience id this service answers to when others call it.
SELF_AUDIENCE=service-a

# Which audience and scopes to request when calling service B.
SERVICE_B_AUDIENCE=service-b
SERVICE_B_SCOPES=orders:read
