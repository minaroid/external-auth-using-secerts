# ---------------------------------------------------------------------------
# service-b — the resource server
# ---------------------------------------------------------------------------
B_PORT=3002
HOST=0.0.0.0

AUTH_BASE_URL=http://localhost:3000

# This service's own identity at the auth service. Service B needs credentials
# because verifying a token is itself an authenticated call.
# CLIENT_SECRET is written by `npm run seed`.
CLIENT_ID=service-b
CLIENT_SECRET=

# The audience id this service answers to. Tokens minted for anyone else are
# rejected.
SELF_AUDIENCE=service-b

# How long an introspection result may be reused. This is the dial between
# revocation latency and load on the auth service.
INTROSPECTION_CACHE_MS=30000
